{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c4-view.dev/schema/model-0.2.json",
  "title": "c4-view model",
  "type": "object",
  "required": [
    "id",
    "title",
    "levels"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rankGap": {
          "type": "number",
          "minimum": 40
        },
        "nodeGap": {
          "type": "number",
          "minimum": 8
        },
        "lane": {
          "type": "number",
          "minimum": 8
        },
        "labelMaxChars": {
          "type": "integer",
          "minimum": 8
        }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/level"
      }
    }
  },
  "$defs": {
    "level": {
      "type": "object",
      "required": [
        "path",
        "nodes",
        "edges"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(|[A-Za-z0-9][A-Za-z0-9_-]{0,63}(/[A-Za-z0-9][A-Za-z0-9_-]{0,63})*)$"
        },
        "title": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "flow": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s>]+->[^\\s>]+$"
          }
        },
        "ports": {
          "type": "object",
          "description": "Makes this level a LENS: the inside of the parent's host node. Key = an edge key of the PARENT level that touches the host; value = the node of THIS level that edge attaches to. Omit to render standalone.",
          "propertyNames": {
            "pattern": "^[^>\\s]+->[^>\\s]+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "subtype": {
          "type": "string"
        },
        "tech": {
          "type": "string"
        },
        "desc": {
          "type": "string"
        },
        "identity": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "rank": {
          "type": "integer",
          "minimum": 0
        },
        "size": {
          "type": "object",
          "description": "A floor on the box, both axes. Text still decides the minimum; use it when a node has many incoming edges and needs width to land their ports apart.",
          "properties": {
            "w": {
              "type": "number",
              "minimum": 1
            },
            "h": {
              "type": "number",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "links": {
          "type": "array",
          "maxItems": 5,
          "description": "External documentation for this box (a wiki page, a runbook). Only http(s) is accepted; the first link is drawn as a chip in the box's corner.",
          "items": {
            "type": "object",
            "required": [
              "href"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 60,
                "description": "what the reader will find; shown on hover"
              },
              "href": {
                "type": "string",
                "maxLength": 400,
                "pattern": "^https?://"
              }
            }
          }
        },
        "state": {
          "enum": [
            "built",
            "planned",
            "partial",
            "retired"
          ],
          "description": "How real this box is. Absent means built. Anything other than built draws a corner tag AND fails the audit, so a roadmap cannot be mistaken for the system."
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "desc": {
          "type": "string",
          "description": "one sentence on what crosses this edge; shown on hover and under the flow caption"
        },
        "label": {
          "type": "string"
        },
        "style": {
          "enum": [
            "flow",
            "dep",
            "tent",
            "dir"
          ]
        }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "label",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
