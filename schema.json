{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c4-view.dev/schema/model-0.2.json",
  "title": "c4-view model",
  "type": "object",
  "required": [
    "id",
    "title",
    "levels"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rankGap": {
          "type": "number",
          "minimum": 40
        },
        "nodeGap": {
          "type": "number",
          "minimum": 8
        },
        "lane": {
          "type": "number",
          "minimum": 8
        },
        "labelMaxChars": {
          "type": "integer",
          "minimum": 8
        }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/level"
      }
    }
  },
  "$defs": {
    "level": {
      "type": "object",
      "required": [
        "path",
        "nodes",
        "edges"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(|[A-Za-z0-9][A-Za-z0-9_-]{0,63}(/[A-Za-z0-9][A-Za-z0-9_-]{0,63})*)$"
        },
        "title": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "flow": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s>]+->[^\\s>]+$"
          }
        },
        "ports": {
          "type": "object",
          "description": "Makes this level a LENS: the inside of the parent's host node. Key = an edge key of the PARENT level that touches the host; value = the node of THIS level that edge attaches to. Omit to render standalone.",
          "propertyNames": {
            "pattern": "^[^>\\s]+->[^>\\s]+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "subtype": {
          "type": "string"
        },
        "tech": {
          "type": "string"
        },
        "desc": {
          "type": "string"
        },
        "identity": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "rank": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "style": {
          "enum": [
            "flow",
            "dep",
            "tent",
            "dir"
          ]
        }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "label",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
