{
  "id": "nested",
  "title": "Nested bakery",
  "levels": [
    {
      "path": "",
      "title": "Containers",
      "nodes": [
        { "id": "browser", "label": "Customer browser", "subtype": "person", "tech": "phone or laptop", "identity": "BAK-1" },
        { "id": "shop", "label": "Shop front", "subtype": "web-application", "tech": "React 19", "identity": "BAK-2" },
        { "id": "orders", "label": "Orders service", "subtype": "microservice", "tech": "FastAPI", "identity": "BAK-3" },
        { "id": "ledger", "label": "Order ledger", "subtype": "database", "tech": "Postgres", "identity": "BAK-4" },
        { "id": "kitchen", "label": "Baking floor", "subtype": "system", "tech": "two ovens", "identity": "BAK-5" }
      ],
      "edges": [
        { "from": "browser", "to": "shop", "label": "HTTPS" },
        { "from": "shop", "to": "orders", "label": "REST" },
        { "from": "orders", "to": "ledger", "label": "writes" },
        { "from": "orders", "to": "kitchen", "label": "queue" },
        { "from": "kitchen", "to": "orders", "label": "done", "style": "dep" }
      ],
      "flow": ["browser->shop", "shop->orders", "orders->ledger", "orders->kitchen", "kitchen->orders"]
    },
    {
      "path": "orders",
      "title": "Orders internals",
      "nodes": [
        { "id": "router", "label": "Router", "subtype": "service-logic", "tech": "FastAPI routers", "identity": "ORD-1" },
        { "id": "pricing", "label": "Pricing", "subtype": "service-logic", "tech": "rules table", "identity": "ORD-2" },
        { "id": "store", "label": "Ledger writer", "subtype": "service-logic", "tech": "SQL", "identity": "ORD-3" },
        { "id": "queue", "label": "Queue client", "subtype": "service-logic", "tech": "Redis", "identity": "ORD-4" }
      ],
      "edges": [
        { "from": "router", "to": "pricing", "label": "quote" },
        { "from": "pricing", "to": "store", "label": "total" },
        { "from": "store", "to": "queue", "label": "enqueue" }
      ],
      "ports": {
        "shop->orders": "router",
        "orders->ledger": "store",
        "orders->kitchen": "queue",
        "kitchen->orders": "queue"
      },
      "flow": ["router->pricing", "pricing->store", "store->queue"]
    },
    {
      "path": "orders/pricing",
      "title": "Pricing internals",
      "nodes": [
        { "id": "rules", "label": "Rules table", "subtype": "config-file", "tech": "JSON", "identity": "PRC-1" },
        { "id": "total", "label": "Total", "subtype": "service-logic", "tech": "sum + tax", "identity": "PRC-2" }
      ],
      "edges": [{ "from": "rules", "to": "total", "label": "applies" }],
      "ports": { "router->pricing": "rules", "pricing->store": "total" },
      "flow": ["rules->total"]
    }
  ]
