{
  "name": "c4-view",
  "version": "0.12.5",
  "type": "module",
  "description": "Agent-driven C4 renderer: a JSON model in, deterministic SVG / PNG / live viewer out. No editing UI \u2014 the layout is computed and gated.",
  "bin": {
    "c4v": "./bin/c4v.mjs"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info",
    "check": "tsc --noEmit",
    "gate": "node tools/gate.mjs && npx tsc --noEmit && node --test",
    "goldens": "node tools/golden.mjs",
    "goldens:update": "node tools/golden.mjs --save",
    "render": "node src/cli.ts render",
    "serve": "node src/cli.ts serve",
    "sonar": "sonar-scanner -Dsonar.host.url=http://127.0.0.1:9000",
    "doctor": "node src/cli.ts doctor",
    "install-skill": "bash scripts/install-skill.sh",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "report:security": "node scripts/security-report.mjs",
    "version": "node scripts/security-report.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "public/",
    "data/",
    "skill/",
    "examples/",
    "docs/c4/",
    "docs/readme/",
    "docs/LAYOUT-SPEC.md",
    "docs/HTTP-API.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "c4",
    "c4-model",
    "architecture",
    "diagram",
    "svg",
    "agent",
    "skill",
    "llm",
    "cli",
    "layout"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaits98/c4-view.git"
  },
  "homepage": "https://github.com/chaits98/c4-view#readme",
  "bugs": {
    "url": "https://github.com/chaits98/c4-view/issues"
  },
  "author": "chaits98"
}
